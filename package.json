{
  "name": "placas-avaliacoes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Redirecionador permanente para as placas de avaliacao (QR + NFC).",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:migrate": "wrangler d1 migrations apply placas-avaliacoes --local",
    "db:migrate:remote": "wrangler d1 migrations apply placas-avaliacoes --remote",
    "db:seed": "wrangler d1 execute placas-avaliacoes --local --file=seeds/dev-seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate",
    "db:list": "wrangler d1 execute placas-avaliacoes --local --command \"SELECT code, status, establishment, destination_url FROM plates ORDER BY code;\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:e2e": "scripts/dev-server.sh start",
    "dev:stop": "scripts/dev-server.sh stop",
    "preflight": "scripts/preflight.sh",
    "smoke": "scripts/smoke.sh",
    "deploy": "npm run preflight && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@types/node": "^22.20.3",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.133.0"
  }
}
